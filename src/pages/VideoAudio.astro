---
import fs from 'fs';
import path from 'path';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const videoDir = path.resolve('./public/VideosAudios');
const thumbnailDir = path.resolve('./public/images/thumbnails');

const files = fs.readdirSync(videoDir).filter(file => file.endsWith('.mp4'));

const toThumbnailName = (filename: string): string => {
  const base = filename.replace('.mp4', '').toLowerCase();

  if (base === 'love') return 'L.O.V.E1.webp';

  return base
    .split(' ')
    .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ') + '1.webp';
};

const beautify = (filename: string) =>
  filename
    .replace('.mp4', '')
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, char => char.toUpperCase());

const withPoster = files.map(file => {
  const thumbFile = toThumbnailName(file);
  const thumbPath = `/images/thumbnails/${thumbFile}`;
  const absoluteThumb = path.join(thumbnailDir, thumbFile);
  const hasPoster = fs.existsSync(absoluteThumb);
  return { file, poster: hasPoster ? thumbPath : null };
});

const title = "Video & Audio - Timeless Messengers";
const description = "Discover the Video and Audio collection of Timeless Messengers: immersive spiritual journeys and captivating stories.";
const keywords = "timeless messengers, video, audio, spiritual videos, audio stories, multimedia";
const image = "/images/photo3better.webp";
---

<Layout {title} {description} {keywords} {image}>
  <div
    class="relative h-48 sm:h-64 md:h-96 bg-cover bg-[position:50%_20%] text-white flex items-center"
    style="background-image: url('/images/photo3better.webp');"
  >
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="relative z-10 pl-6 sm:pl-12 md:pl-20 text-left w-full">
      <h1 class="text-xl sm:text-3xl md:text-5xl font-bold tracking-wide drop-shadow-lg mb-2">
        Video/Audio
      </h1>
    </div>
  </div>

  <section class="max-w-6xl mx-auto py-8 px-2 sm:py-12 sm:px-4 md:py-16 md:px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 md:gap-8">
      {withPoster.map(({ file, poster }) => (
        <div class="bg-white dark:bg-zinc-900 p-2 sm:p-4 rounded-2xl shadow-xl transition hover:scale-[1.01] flex flex-col">
          <div class="h-64 sm:h-72 md:h-80 overflow-hidden rounded-lg">
            <video
              controls
              class="w-full h-full object-cover rounded-lg shadow-md"
              {...(poster ? { poster } : {})}
            >
              <source src={`/VideosAudios/${file}`} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
          <p class="mt-2 sm:mt-4 text-center text-base sm:text-lg font-medium text-gray-700 dark:text-gray-300">
            {beautify(file)}
          </p>
        </div>
      ))}
    </div>
  </section>

  <script type="module" src="/scripts/pause-videos.js"></script>
</Layout>