---
// No se necesita JS aquí, solo estilos
import "../styles/global.css";
---

<div class="max-w-5xl mx-auto py-6 flex items-center justify-center gap-4">
  <a href="https://www.bandnameprotection.de/">
    <img
      class="h-8 w-auto"
      src="/images/bandnameprotection_donotcopy.webp"
      alt="Bandname Protector"
      loading="lazy"
    />
  </a>

  <p class="text-center text-gray-300 m-0">
    &copy; {new Date().getFullYear()} Timeless Messengers.
  </p>

  <a href="https://www.musiker-in-deiner-stadt.at/kleinanzeigen.finden/gitarrist-gitarrenspieler-wien">
    <img
      class="h-8 w-auto"
      src="/images/mids.webp"
      alt="Musiker in deiner Stadt"
      loading="lazy"
    />
  </a>
</div>
